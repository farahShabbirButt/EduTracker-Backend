# Copy to .env for local development. On Render these are set in the service's Environment
# page instead (render.yaml sets the fixed ones); .env is never committed and never deployed.

# development | production. production turns on the Secure cookie and checks the settings below
NODE_ENV=development
PORT=5000

# PostgreSQL. Keep ?schema=edu_tracker: an early migration names that schema.
# Local:  postgresql://<user>:<password>@localhost:5432/<database>?schema=edu_tracker
# Neon:   the direct (not pooled) connection string, with &schema=edu_tracker added
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edutracker?schema=edu_tracker

# Login tokens are signed with this. At least 32 characters in production:
#   openssl rand -hex 64
# Changing it signs everyone out. On Render, render.yaml generates it.
JWT_SECRET=
JWT_EXPIRES_IN=24h
AUTH_COOKIE_NAME=et_auth

# The address people open. Reset-password emails link to it.
# Local: http://localhost:5173   Live: https://farrukh-academy-edutracker.onrender.com
FRONTEND_URL=http://localhost:5173

# Email (password reset). The sender, as "Name <address>"; with Brevo it must be a verified sender.
EMAIL_FROM=EduTracker <no-reply@example.com>
# Production: Brevo's API key (Render's free plan blocks SMTP ports, so the API is used)
BREVO_API_KEY=
# Development: any SMTP server instead, e.g. Mailtrap. Ignored when BREVO_API_KEY is set.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Production only. WEB_DIST and TZ are set by render.yaml:
# WEB_DIST=web/dist     the built frontend this server also serves (scripts/build-web.sh)
# TZ=Asia/Karachi       the school's time zone, for "this month" and joining days
# TRUST_PROXY           proxies in front of the server. Defaults to 1 in production (Render's
#                       one) and 0 locally; check it on the live site (DEPLOYMENT.md, step 5)

# Seed only (npx prisma db seed): the first admin login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# true also adds sample grade boundaries and classes, wiping existing ones. Never on live data.
SEED_DEV_DATA=false
